# ---- Base de datos PostgreSQL (Neon / Supabase / Vercel Postgres) ----
# Usa el connection string del pooler para entornos serverless.
DATABASE_URL="postgresql://usuario:password@host:5432/db?sslmode=require"

# ---- Autenticacion ----
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+-caracteres"

# ---- Rate limiting (Upstash Redis / Vercel KV) ----
# Si no se configuran, el rate limiting se degrada de forma segura (permite peticiones).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Almacenamiento de imagenes (Supabase Storage) ----
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
SUPABASE_STORAGE_BUCKET="seeds"

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- WhatsApp del negocio (formato internacional, sin "+") ----
NEXT_PUBLIC_WHATSAPP_NUMBER="50373282078"

# ---- Notificaciones por correo ----
# Opcion recomendada (gratis, sin dominio): Gmail SMTP con contrasena de aplicacion.
# Activa verificacion en 2 pasos y crea una "contrasena de aplicacion" en tu cuenta Google.
# Si GMAIL_USER + GMAIL_APP_PASSWORD estan configurados, se usa Gmail y se ignora Resend.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Alternativa: Resend (para enviar a clientes requiere un dominio verificado).
# Si falta RESEND_API_KEY o NOTIFY_EMAIL_TO, no se envian correos (la app sigue normal).
# NOTIFY_EMAIL_TO admite varios correos separados por coma.
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="tucorreo@ejemplo.com"
EMAIL_FROM="JecsitoShop <onboarding@resend.dev>"
